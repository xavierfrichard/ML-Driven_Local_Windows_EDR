<?xml version="1.0" encoding="utf-8"?>
<!-- Restore only from nuget.org. <clear/> drops any machine- or user-level feeds, and
     packageSourceMapping sends every package ID to nuget.org, so a package cannot be pulled from
     another feed (dependency confusion). Add a source and a mapping here if a private feed is ever needed. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
