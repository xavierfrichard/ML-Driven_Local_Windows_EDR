<Window x:Class="Warden.Ui.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Warden.Ui"
        xmlns:viewModels="clr-namespace:Warden.Ui.ViewModels"
        Title="Warden — Application Blocked" SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" WindowStyle="ToolWindow">



    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Icon -->
        <Viewbox Grid.Column="0" Margin="0,0,16,0" Width="32" Height="32">
            <Canvas Width="32" Height="32">
                <Path Data="M16,2C8.3,2,2,8.3,2,16s6.3,14,14,14s14-6.3,14-14S23.7,2,16,2z M14,20.5L6,12.5l2.8-2.8L14,14.9l8.2-8.2L22,9.7L14,20.5z"
                      Fill="#FF0000" Stretch="Uniform" />
            </Canvas>
        </Viewbox>

        <!-- Content -->
        <StackPanel Grid.Column="1" Margin="0,0,0,8">
            <!-- Mode -->
            <TextBlock Text="{Binding ModeText, Mode=OneWay}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />

            <!-- File info -->
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{Binding FileNameText, Mode=OneWay}" FontWeight="Bold" />
                <TextBlock Text="{Binding PathText, Mode=OneWay}" Foreground="Gray" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ShaText, Mode=OneWay}" FontFamily="Consolas" Foreground="Gray" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Command line -->
            <TextBlock Text="Command line:" FontWeight="Bold" Margin="0,8,0,2" />
            <TextBlock Text="{Binding CommandLineText, Mode=OneWay}" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8" />

            <!-- Parent -->
            <TextBlock Text="Parent:" FontWeight="Bold" Margin="0,8,0,2" />
            <TextBlock Text="{Binding ParentText, Mode=OneWay}" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8" />

            <!-- Signer -->
            <TextBlock Text="Signer:" FontWeight="Bold" Margin="0,8,0,2" />
            <TextBlock Text="{Binding SignerText, Mode=OneWay}" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8" />

            <!-- MOTW -->
            <TextBlock Text="MOTW:" FontWeight="Bold" Margin="0,8,0,2" />
            <TextBlock Text="{Binding MotwText, Mode=OneWay}" Foreground="Gray" Margin="0,0,0,8" />

            <!-- Reason -->
            <TextBlock Text="Reason:" FontWeight="Bold" Margin="0,8,0,2" />
            <TextBlock Text="{Binding ReasonText, Mode=OneWay}" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8" />

            <!-- Assessment panel (ML/LLM) -->
            <Border x:Name="AssessmentPanel" Margin="0,8,0,8" Padding="8" 
                    Background="#FFF8F8F8" CornerRadius="4" 
                    Visibility="{Binding AssessmentPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Assessment:" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding MlText, Mode=OneWay}" Foreground="#FF6600" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding LlmText, Mode=OneWay}" Foreground="#FF6600" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Quarantine" Command="{Binding QuarantineCommand}" 
                        Width="100" Margin="0,0,8,0" />
                <Button Content="Block" Command="{Binding KeepBlockedCommand}" 
                        Width="100" Margin="0,0,8,0" />
                <Button Content="Allow" Command="{Binding AllowCommand}" 
                        Width="100" Margin="0,0,8,0" />
                <TextBlock Text="{Binding CountdownText, Mode=OneWay}" 
                           VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
