<Window x:Class="Warden.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Warden.Ui"
        xmlns:viewModels="clr-namespace:Warden.Ui.ViewModels"
        Title="Warden — Zero-Trust Application Control"
        Height="740" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="True" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="ColumnWidth" Value="SizeToHeader" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready." />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="DbPathText" Foreground="Gray" />
            </StatusBarItem>
        </StatusBar>

        <TabControl x:Name="Tabs">

            <!-- 5. Whitelist (all columns) -->
            <TabItem Header="Whitelist">
                <DockPanel DataContext="{Binding}">
                    <ToolBar DockPanel.Dock="Top">
                        <Button Content="Refresh" Click="RefreshWhitelist_Click" />
                        <Separator />
                        <Button Content="Allow file…" Click="AllowFile_Click" 
                                ToolTip="Pick an executable or DLL: it is allow-listed in WDAC immediately and recorded here as Allow." />
                        <Button Content="Manual Add…" Click="AddWhitelist_Click" />
                        <Separator />
                        <Button Content="Set Allow" Click="WhitelistAllow_Click" />
                        <Button Content="Set Block (revoke)" Click="WhitelistBlock_Click" 
                                ToolTip="Removes the WDAC allow rule for this file and records a Block, so it is blocked again on its next launch." />
                        <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"
                                   Text="One row per SHA-256 — Set Block revokes a previously allowed file." />
                    </ToolBar>
                    <DataGrid x:Name="WhitelistGrid" 
                              ItemsSource="{Binding WhitelistEntries, Mode=OneWay}"
                              SelectedItem="{Binding SelectedWhitelistEntry, Mode=OneWayToSource}" 
                              AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" />
                            <DataGridTextColumn Header="Action" Binding="{Binding Action}" />
                            <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" />
                            <DataGridTextColumn Header="Path" Binding="{Binding ProcessPath}" Width="220" />
                            <DataGridTextColumn Header="LLM verdict" Binding="{Binding LlmVerdict}" />
                            <DataGridTextColumn Header="ML score" Binding="{Binding MlScore}" />
                            <DataGridTextColumn Header="Signer" Binding="{Binding SignerSubject}" Width="180" />
                            <DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256}" Width="200" />
                            <DataGridTextColumn Header="Command line" Binding="{Binding CommandLine}" Width="220" />
                            <DataGridTextColumn Header="Size" Binding="{Binding FileSize}" />
                            <DataGridTextColumn Header="Parent" Binding="{Binding ParentName}" />
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- 6. User Log (everything the user allowed at a prompt) -->
            <TabItem Header="User Log">
                <DockPanel DataContext="{Binding}">
                    <ToolBar DockPanel.Dock="Top">
                        <Button Content="Refresh" Click="RefreshUserLog_Click" />
                        <Separator />
                        <Button Content="Set Allow" Click="UserLogAllow_Click" />
                        <Button Content="Set Block (revoke)" Click="UserLogBlock_Click" 
                                ToolTip="Removes the WDAC allow rule for this file and records a Block, so it is blocked again on its next launch." />
                    </ToolBar>
                    <DataGrid x:Name="UserLogGrid" 
                              ItemsSource="{Binding UserLogEntries, Mode=OneWay}"
                              SelectedItem="{Binding SelectedUserLogEntry, Mode=OneWayToSource}" />
                </DockPanel>
            </TabItem>

            <!-- 9. Rules -->
            <TabItem Header="Rules">
                <DockPanel DataContext="{Binding}">
                    <ToolBar DockPanel.Dock="Top">
                        <Button Content="Refresh" Click="RefreshRules_Click" />
                        <Separator />
                        <Button Content="Add…" Click="AddRule_Click" />
                        <Button Content="Delete selected" Click="DeleteRule_Click" />
                    </ToolBar>
                    <DataGrid x:Name="RulesGrid" 
                              ItemsSource="{Binding RuleEntries, Mode=OneWay}"
                              SelectedItem="{Binding SelectedRuleEntry, Mode=OneWayToSource}" />
                </DockPanel>
            </TabItem>

            <!-- 7. Command Lines -->
            <TabItem Header="Command Lines">
                <DockPanel DataContext="{Binding}">
                    <ToolBar DockPanel.Dock="Top">
                        <Button Content="Refresh" Click="RefreshCommandLines_Click" />
                    </ToolBar>
                    <DataGrid x:Name="CommandLinesGrid" ItemsSource="{Binding CommandLineEntries, Mode=OneWay}" />
                </DockPanel>
            </TabItem>

            <!-- 8. Quarantine -->
            <TabItem Header="Quarantine">
                <DockPanel DataContext="{Binding}">
                    <ToolBar DockPanel.Dock="Top">
                        <Button Content="Refresh" Click="RefreshQuarantine_Click" />
                    </ToolBar>
                    <DataGrid x:Name="QuarantineGrid" ItemsSource="{Binding QuarantineEntries, Mode=OneWay}" />
                </DockPanel>
            </TabItem>

            <!-- 3. Attack Chains -->
            <TabItem Header="Attack Chains">
                <DockPanel DataContext="{Binding}">
                    <ToolBar DockPanel.Dock="Top">
                        <Button Content="Refresh" Click="RefreshChains_Click" />
                    </ToolBar>
                    <DataGrid x:Name="ChainsGrid" ItemsSource="{Binding AttackChainEntries, Mode=OneWay}" />
                </DockPanel>
            </TabItem>

            <!-- 4. Protected Folders -->
            <TabItem Header="Protected Folders">
                <DockPanel DataContext="{Binding}">
                    <ToolBar DockPanel.Dock="Top">
                        <Button Content="Refresh" Click="RefreshFolders_Click" />
                        <Separator />
                        <Button Content="Add folder…" Click="AddFolder_Click" />
                        <Button Content="Delete selected" Click="DeleteFolder_Click" />
                    </ToolBar>
                    <DataGrid x:Name="FoldersGrid" 
                              ItemsSource="{Binding ProtectedFolders, Mode=OneWay}"
                              SelectedItem="{Binding SelectedFolderEntry, Mode=OneWayToSource}" />
                </DockPanel>
            </TabItem>

            <!-- 1. Advanced (vulnerable apps / mitigation profiles / firewall) -->
            <TabItem Header="Advanced">
                <DockPanel DataContext="{Binding}">
                    <ToolBar DockPanel.Dock="Top">
                        <Button Content="Refresh" Click="RefreshAdvanced_Click" />
                        <Separator />
                        <TextBlock VerticalAlignment="Center" Foreground="Gray"
                                   Text="Firewall checkboxes apply real Windows Firewall rules via the service. Mitigation profiles stay installer-driven." />
                    </ToolBar>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <GroupBox Grid.Row="0" Header="Vulnerable apps (EP-reset ∪ LOLBAS)">
                            <!-- Explicit columns: the shared style makes grids read-only (so text cells cannot be
                                 edited), which renders an auto-generated DataGridCheckBoxColumn permanently
                                 disabled. A CheckBox in a template column is a live control, not an edit-mode
                                 cell, so it stays clickable and raises Click on the first press. -->
                            <DataGrid x:Name="VulnAppsGrid" ItemsSource="{Binding VulnerableAppRecords, Mode=OneWay}" AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="App" Binding="{Binding AppPath}" Width="320" />
                                    <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="160" />
                                    <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" />
                                    <DataGridTemplateColumn Header="Block inbound">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox Tag="in"
                                                          HorizontalAlignment="Center"
                                                          IsChecked="{Binding FwInBlocked, Mode=OneWay}"
                                                          Checked="FirewallCheck_Click" Unchecked="FirewallCheck_Click" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Block outbound">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox Tag="out"
                                                          HorizontalAlignment="Center"
                                                          IsChecked="{Binding FwOutBlocked, Mode=OneWay}"
                                                          Checked="FirewallCheck_Click" Unchecked="FirewallCheck_Click" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Mitigation profile" Binding="{Binding MitigationProfileId}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                        <GroupBox Grid.Row="1" Header="Mitigation profiles">
                            <DataGrid x:Name="MitigationGrid" ItemsSource="{Binding MitigationProfiles, Mode=OneWay}" />
                        </GroupBox>
                        <GroupBox Grid.Row="2" Header="Firewall rules">
                            <DataGrid x:Name="FirewallGrid" ItemsSource="{Binding FirewallRules, Mode=OneWay}" />
                        </GroupBox>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- 2. Web Apps (always-ON) -->
            <TabItem Header="Web Apps">
                <DockPanel DataContext="{Binding}">
                    <ToolBar DockPanel.Dock="Top">
                        <Button Content="Refresh" Click="RefreshWebApps_Click" />
                    </ToolBar>
                    <DataGrid x:Name="WebAppsGrid" ItemsSource="{Binding WebAppClassifications, Mode=OneWay}" />
                </DockPanel>
            </TabItem>

            <!-- Bonus: Tamper Log (self-protection audit trail) -->
            <TabItem Header="Tamper Log">
                <DockPanel DataContext="{Binding}">
                    <ToolBar DockPanel.Dock="Top">
                        <Button Content="Refresh" Click="RefreshTamper_Click" />
                    </ToolBar>
                    <DataGrid x:Name="TamperGrid" ItemsSource="{Binding TamperEvents, Mode=OneWay}" />
                </DockPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
