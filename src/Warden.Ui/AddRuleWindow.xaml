<Window x:Class="Warden.Ui.AddRuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Warden.Ui"
        xmlns:viewModels="clr-namespace:Warden.Ui.ViewModels"
        Title="Add Rule" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    


    <StackPanel Margin="16">
        <TextBlock Text="Kind" />
        <ComboBox x:Name="KindBox" Margin="0,2,0,8" 
                  ItemsSource="{Binding RuleKinds}"
                  SelectedItem="{Binding SelectedKind, Mode=TwoWay}"
                  SelectionChanged="KindBox_SelectionChanged" />

        <TextBlock x:Name="MatchHint" Text="{Binding MatchHint, Mode=OneWay}" TextWrapping="Wrap" />
        <Grid Margin="0,2,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="MatchBox" Grid.Column="0" 
                     FontFamily="Consolas" 
                     Text="{Binding MatchValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button x:Name="BrowseButton" Grid.Column="1" 
                    Content="Browse…" Width="84" Margin="8,0,0,0" 
                    Command="{Binding BrowseCommand}" 
                    IsEnabled="{Binding BrowseButtonEnabled, Mode=OneWay}" />
        </Grid>
        <TextBlock x:Name="SourceHint" Text="{Binding SourceHint, Mode=OneWay}" 
                   Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8" />

        <TextBlock Text="Action" />
        <ComboBox x:Name="ActionBox" Margin="0,2,0,8" 
                  ItemsSource="{Binding Actions}"
                  SelectedItem="{Binding SelectedAction, Mode=TwoWay}" />

        <CheckBox x:Name="RequireSigBox" Content="Require a valid signature (allow rules only)" 
                  Margin="0,4" IsChecked="{Binding RequireSignature, Mode=TwoWay}" />
        <CheckBox x:Name="RequireWlBox" Content="Require existing whitelist status (allow rules only)" 
                  Margin="0,4" IsChecked="{Binding RequireWhitelist, Mode=TwoWay}" />

        <TextBlock Text="Note (optional)" Margin="0,8,0,0" />
        <TextBox x:Name="NoteBox" Margin="0,2,0,8" 
                 Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="OK" IsDefault="True" Width="84" Margin="0,0,8,0" 
                    Command="{Binding OkCommand}" 
                    IsEnabled="{Binding OkCommand.CanExecute}" />
            <Button Content="Cancel" IsCancel="True" Width="84" />
        </StackPanel>
    </StackPanel>
</Window>
