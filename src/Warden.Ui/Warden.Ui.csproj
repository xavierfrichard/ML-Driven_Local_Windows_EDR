<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Warden.Ipc\Warden.Ipc.csproj" />
    <ProjectReference Include="..\Warden.Storage\Warden.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <!-- The management window opens the SQLite database directly (via Warden.Storage's repos), so the UI
         depends on these at runtime. Referencing them directly (not just transitively through
         Warden.Storage) guarantees they land in the UI output even on an incremental build — a stale
         incremental build once shipped a UI without Dapper/Sqlite, crashing when a panel opened. -->
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- CA1001 false positive: App disposes _pipeClient/_singleInstanceMutex/_trayIcon in OnExit,
         which the analyzer does not recognize as the WPF disposal path. -->
    <NoWarn>$(NoWarn);CA1001</NoWarn>
  </PropertyGroup>

</Project>
