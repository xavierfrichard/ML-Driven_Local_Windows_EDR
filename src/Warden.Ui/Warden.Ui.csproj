<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Warden.Ipc\Warden.Ipc.csproj" />
    <!-- Storage is referenced for its entity records only: they are the wire shape of the management
         channel's JSON. The UI no longer opens the SQLite file (the service owns every read and write),
         so it needs no Dapper/Sqlite reference of its own. -->
    <ProjectReference Include="..\Warden.Storage\Warden.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- CA1001 false positive: App disposes _pipeClient/_singleInstanceMutex/_trayIcon in OnExit,
         which the analyzer does not recognize as the WPF disposal path. -->
    <NoWarn>$(NoWarn);CA1001</NoWarn>
  </PropertyGroup>

</Project>
