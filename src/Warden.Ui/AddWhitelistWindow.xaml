<Window x:Class="Warden.Ui.AddWhitelistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manual Whitelist Entry" Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="Process path" />
        <TextBox x:Name="PathBox" Margin="0,2,0,8" />

        <TextBlock Text="SHA-256 (optional, uppercase hex)" />
        <TextBox x:Name="ShaBox" Margin="0,2,0,8" FontFamily="Consolas" />

        <TextBlock Text="Action" />
        <ComboBox x:Name="ActionBox" Margin="0,2,0,8" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="OK" IsDefault="True" Width="84" Margin="0,0,8,0" Click="Ok_Click" />
            <Button Content="Cancel" IsCancel="True" Width="84" />
        </StackPanel>
    </StackPanel>
</Window>
