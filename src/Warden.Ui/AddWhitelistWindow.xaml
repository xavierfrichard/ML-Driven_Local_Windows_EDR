<Window x:Class="Warden.Ui.AddWhitelistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Warden.Ui"
        xmlns:viewModels="clr-namespace:Warden.Ui.ViewModels"
        Title="Manual Whitelist Entry" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">



    <StackPanel Margin="16">
        <TextBlock Text="File (Browse… fills the path and computes the SHA-256)" />
        <Grid Margin="0,2,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PathBox" Grid.Column="0" 
                     Text="{Binding Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" Content="Browse…" Width="84" Margin="8,0,0,0" 
                    Command="{Binding BrowseCommand}" />
        </Grid>

        <TextBlock Text="SHA-256 (uppercase hex)" />
        <TextBox x:Name="ShaBox" Margin="0,2,0,8" 
                 FontFamily="Consolas" 
                 Text="{Binding Sha256, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="Action" />
        <ComboBox x:Name="ActionBox" Margin="0,2,0,8" 
                  ItemsSource="{Binding Actions}"
                  SelectedItem="{Binding SelectedAction, Mode=TwoWay}" />
        <TextBlock Text="Allow deploys the WDAC rule for this file immediately; Block records a decision the pipeline replays." Foreground="Gray" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="OK" IsDefault="True" Width="84" Margin="0,0,8,0" 
                    Command="{Binding OkCommand}" 
                    IsEnabled="{Binding OkCommand.CanExecute}" />
            <Button Content="Cancel" IsCancel="True" Width="84" />
        </StackPanel>
    </StackPanel>
</Window>
